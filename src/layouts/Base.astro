---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "The Library — an indexed, cross-referenced archive of Mike Wolf's writing: a working dictionary of terms, and the long-form corpus behind them.",
} = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/dictionary/', label: 'Dictionary' },
  { href: '/corpus/', label: 'Corpus' },
  { href: '/atlas/', label: 'Atlas' },
  { href: '/about/', label: 'About' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — The Library</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --serif: 'Literata', Georgia, serif;
      --sans: 'Outfit', system-ui, sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }
    body { font-family: var(--sans); }
    h1, h2, h3, h4, .serif { font-family: var(--serif); }
  </style>
</head>
<body class="bg-bg text-ink min-h-screen flex flex-col">
  <!-- Nav -->
  <nav class="sticky top-0 z-50 bg-bg/90 backdrop-blur-md border-b border-rule">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="font-serif font-medium text-lg text-ink hover:text-copper transition-colors tracking-wide">
        The Library
      </a>
      <div class="flex items-center gap-5 text-sm font-medium text-muted">
        {nav.slice(1).map(n => (
          <a href={n.href} class="hover:text-copper transition-colors">{n.label}</a>
        ))}
      </div>
    </div>
  </nav>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="border-t border-rule mt-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-muted text-sm text-center sm:text-left font-serif italic">
        The writing of Mike Wolf — collected, indexed, cross-referenced. 2026.
      </p>
      <p class="text-faint text-xs font-mono">
        <a href="https://mike-wolf.com" class="hover:text-copper transition-colors">mike-wolf.com</a>
      </p>
    </div>
  </footer>
</body>
</html>
