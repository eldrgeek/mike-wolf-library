---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "The Library — an indexed, cross-referenced archive of Mike Wolf's writing: a working dictionary of terms, and the long-form corpus behind them.",
} = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/dictionary/', label: 'Dictionary' },
  { href: '/corpus/', label: 'Corpus' },
  { href: '/atlas/', label: 'Atlas' },
  { href: '/about/', label: 'About' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — The Library</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --serif: 'Literata', Georgia, serif;
      --sans: 'Outfit', system-ui, sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }
    body { font-family: var(--sans); }
    h1, h2, h3, h4, .serif { font-family: var(--serif); }
  </style>
</head>
<body class="bg-bg text-ink min-h-screen flex flex-col">
  <!-- Nav -->
  <nav class="sticky top-0 z-50 bg-bg/90 backdrop-blur-md border-b border-rule">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="font-serif font-medium text-lg text-ink hover:text-copper transition-colors tracking-wide">
        The Library
      </a>
      <div class="flex items-center gap-5 text-sm font-medium text-muted">
        {nav.slice(1).map(n => (
          <a href={n.href} class="hover:text-copper transition-colors">{n.label}</a>
        ))}
      </div>
    </div>
  </nav>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="border-t border-rule mt-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-muted text-sm text-center sm:text-left font-serif italic">
        The writing of Mike Wolf — collected, indexed, cross-referenced. 2026.
      </p>
      <p class="text-faint text-xs font-mono">
        <a href="https://mike-wolf.com" class="hover:text-copper transition-colors">mike-wolf.com</a>
      </p>
    </div>
  </footer>

  <!-- SOMA App Standard §8 — feedback chip. Self-hosted (same origin) rather
       than pulled from the VPS: one less third party in the read path, and it
       keeps soma-ship-check's asset-integrity check honest. Google One Tap is
       off (data-no-google): library.mike-wolf.com is not a registered origin
       on the chip's GIS client, and an unregistered origin throws in-browser. -->
  <link rel="stylesheet" href="/vendor/soma-feedback/soma-feedback.css" />
  <script is:inline defer src="/vendor/soma-feedback/soma-feedback.js"
          data-app="mike-wolf-library" data-area="library" data-no-google></script>

  <!--
    SOMA §17 / §17a Live Edit — admin bootstrap.

    THE WHOLE POINT OF THIS BLOCK is that a reader pays nothing for it. The
    Library is a public archive that is deliberately zero-auth, zero-function,
    $0/query. So nothing above loads unless the visitor has already declared
    themselves an admin. No Supabase client, no auth config, no query, no
    fetch — an anonymous visitor makes exactly the requests they made before
    this feature existed.

    Canonical copy is not served from the database either. "Make canonical"
    writes the new wording back into the SOURCE FILE and GitHub redeploys, so
    a logged-out visitor reads the edit out of static HTML. That is Tier 1 as
    the standard describes it: the change ships when the fleet applies it.

    Admin path is any of:
      ?edit=1  or  #edit   — first time, or from a phone
      a live SOMA Auth session already in this browser
      the sticky flag this sets once you've opted in (clear with ?edit=0)
  -->
  <script is:inline>
    (function () {
      var K = 'mwl-live-edit';
      var q = location.search + location.hash;
      var on = false;
      try {
        if (/[?#&]edit=0\b/.test(q)) localStorage.removeItem(K);
        else if (/[?#&]edit(=1)?\b/.test(q)) localStorage.setItem(K, '1');
        on = localStorage.getItem(K) === '1';
        // A live session counts too, so a signed-in admin keeps the bar
        // across navigations without carrying ?edit=1 around.
        if (!on) {
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') > 0) { on = true; break; }
          }
        }
      } catch (e) { /* private mode: stay off, cost nothing */ }
      if (!on) return;

      function css(href) {
        var l = document.createElement('link');
        l.rel = 'stylesheet'; l.href = href; document.head.appendChild(l);
      }
      // Sequential, not parallel: soma-auth.js needs window.supabase and the
      // config object to exist before it runs, and live-edit.js needs
      // window.SomaAuth. Load order is the contract here.
      function js(src, next) {
        var s = document.createElement('script');
        s.src = src; s.onload = next || null;
        document.body.appendChild(s);
      }
      // Everything site-specific about the engine lives here, so
      // /js/live-edit.js stays byte-identical to mike-wolf.com's copy.
      window.SOMA_LIVE_EDIT = {
        app: 'mike-wolf-library',
        api: '/api/copy-canonize',
        // Each dictionary entry renders as <article id="term-<slug>">, which
        // tells canonize which source file to patch. A HINT, never the key.
        hintSelector: 'article[id^="term-"]',
        hintPrefix: 'term-',
        // The dictionary's own filter chrome and the search boxes: controls,
        // not copy.
        skip: ['#dict-nav', '#dict-search', '#corpus-search', '#atlas-tip', '#search-results'],
        userContentMessage: 'Archive text is not editable — that is a published original.'
      };
      css('/css/live-edit.css');
      js('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js', function () {
        js('/js/soma-auth-config.js', function () {
          js('/js/soma-auth.js', function () {
            js('/js/live-edit.js', function () { window.SomaLiveEdit.init(); });
          });
        });
      });
    })();
  </script>
</body>
</html>
