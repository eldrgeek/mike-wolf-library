---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const rawSources = await getCollection('sources');

const sources = rawSources.map(e => ({
  slug: e.slug,
  title: e.data.title,
  subtitle: e.data.subtitle ?? '',
  collection: e.data.collection,
  kind: e.data.kind,
  order: e.data.order ?? 0,
  date: e.data.date ?? '',
  excerpt: e.data.excerpt ?? '',
  words: e.data.word_count ?? 0,
}));

// Group by collection, ordered.
const collOrder = ['SRMW', 'Silicon Children', '70YearsWTF', 'AI WTF'];
const byCollection = collOrder
  .map(c => ({
    name: c,
    items: sources
      .filter(s => s.collection === c)
      .sort((a, b) => (a.order - b.order) || a.title.localeCompare(b.title)),
  }))
  .filter(g => g.items.length > 0);

const collLabel: Record<string, string> = {
  'SRMW': 'Self-Referential Metanovel',
  'Silicon Children': 'Silicon Children',
  '70YearsWTF': '70 Years WTF',
  'AI WTF': 'AI WTF',
};
const total = sources.length;
---
<Base title="Corpus" description={`The long-form corpus behind the dictionary — ${total} sources across Mike Wolf's books, essays, and posts. Full-text searchable.`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Archive</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-3">Corpus</h1>
    <p class="text-muted max-w-2xl font-serif leading-relaxed mb-2">
      {total} sources — the writing the dictionary is drawn from. Read any piece in full; search runs across every word, entirely in your browser.
    </p>
    <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted font-mono">
      {byCollection.map(g => <span>{g.items.length} · {collLabel[g.name] ?? g.name}</span>)}
    </div>

    <!-- Search -->
    <div class="sticky top-14 z-40 bg-bg/95 backdrop-blur-sm border-b border-rule -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 mt-6 mb-6">
      <div class="flex flex-col sm:flex-row gap-3 items-center">
        <input id="corpus-search" type="search" placeholder="Search the full text of every source…"
          class="flex-1 w-full px-4 py-2 bg-surface border border-rule rounded-md text-sm text-ink placeholder-faint focus:outline-none focus:ring-2 focus:ring-copper/25 focus:border-copper" />
        <span id="corpus-count" class="text-xs text-muted font-mono whitespace-nowrap"></span>
      </div>
    </div>

    <!-- Search results (hidden until typing) -->
    <div id="search-results" class="hidden divide-y divide-rule mb-8"></div>

    <!-- Browse by collection (default view) -->
    <div id="browse">
      {byCollection.map(g => (
        <section class="mb-12">
          <h2 class="font-serif text-2xl text-ink mb-1">{collLabel[g.name] ?? g.name}</h2>
          <p class="text-xs font-mono text-muted mb-5">{g.items.length} {g.items.length === 1 ? 'piece' : 'pieces'}</p>
          <div class="divide-y divide-rule">
            {g.items.map(item => (
              <a href={`/corpus/${item.slug}/`} class="corpus-row block py-4 group">
                <div class="flex items-baseline gap-2 flex-wrap">
                  <span class="text-ink font-medium text-base group-hover:text-copper transition-colors font-serif">{item.title}</span>
                  <span class="shrink-0 text-[10px] font-mono uppercase tracking-wide bg-teal-light text-teal border border-teal-border px-1.5 py-0.5 rounded">{item.kind}</span>
                </div>
                {item.subtitle && <p class="text-xs text-muted italic mt-0.5">{item.subtitle}</p>}
                {item.excerpt && <p class="text-sm text-muted mt-1 leading-relaxed line-clamp-2">{item.excerpt}</p>}
                <div class="mt-1 flex gap-3 text-[11px] font-mono text-faint">
                  {item.date && <span>{item.date}</span>}
                  {item.words > 0 && <span>{item.words.toLocaleString()} words</span>}
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script>
    import MiniSearch from 'minisearch';

    const searchEl = document.getElementById('corpus-search') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results') as HTMLElement;
    const browseEl = document.getElementById('browse') as HTMLElement;
    const countEl = document.getElementById('corpus-count') as HTMLElement;

    let mini: any = null;
    let docs: any[] = [];

    async function ensureIndex() {
      if (mini) return;
      const res = await fetch('/search-index.json');
      docs = await res.json();
      mini = new MiniSearch({
        fields: ['title', 'subtitle', 'text', 'collection'],
        storeFields: ['title', 'subtitle', 'collection', 'url', 'kind', 'text'],
        searchOptions: { boost: { title: 3, subtitle: 2 }, prefix: true, fuzzy: 0.2 },
      });
      mini.addAll(docs.map((d: any, i: number) => ({ ...d, _id: i })));
    }

    function esc(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function snippet(text: string, q: string) {
      const low = text.toLowerCase();
      const idx = low.indexOf(q.toLowerCase().split(' ')[0]);
      const start = idx < 0 ? 0 : Math.max(0, idx - 60);
      let s = text.slice(start, start + 220).trim();
      if (start > 0) s = '…' + s;
      return esc(s) + '…';
    }

    async function run(q: string) {
      q = q.trim();
      if (!q) {
        resultsEl.classList.add('hidden');
        browseEl.classList.remove('hidden');
        countEl.textContent = '';
        return;
      }
      await ensureIndex();
      const hits = mini.search(q, { combineWith: 'AND' }).slice(0, 40);
      browseEl.classList.add('hidden');
      resultsEl.classList.remove('hidden');
      countEl.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'}`;
      if (hits.length === 0) {
        resultsEl.innerHTML = '<p class="py-10 text-center text-muted">No matches.</p>';
        return;
      }
      resultsEl.innerHTML = hits.map((h: any) => {
        const kindBadge = h.kind === 'term' ? 'Dictionary' : h.collection;
        return `<a href="${h.url}" class="block py-4 group">
          <div class="flex items-baseline gap-2 flex-wrap">
            <span class="text-ink font-medium font-serif group-hover:text-copper transition-colors">${esc(h.title)}</span>
            <span class="text-[10px] font-mono uppercase tracking-wide bg-copper-light text-copper border border-copper-border px-1.5 py-0.5 rounded">${esc(kindBadge)}</span>
          </div>
          ${h.subtitle ? `<p class="text-xs text-muted italic mt-0.5">${esc(h.subtitle)}</p>` : ''}
          <p class="text-sm text-muted mt-1 leading-relaxed">${snippet(h.text || '', q)}</p>
        </a>`;
      }).join('');
    }

    let t: any;
    searchEl?.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(() => run(searchEl.value), 120);
    });
    // Support ?q= deep link
    const params = new URLSearchParams(location.search);
    if (params.get('q')) { searchEl.value = params.get('q')!; run(searchEl.value); }
  </script>
</Base>
