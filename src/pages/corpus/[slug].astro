---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const terms = await getCollection('terms');

  const termBySlug = new Map(terms.map(t => [t.data.slug ?? t.id.replace(/\.md$/, ''), t.data.title]));
  const srcTitle = new Map(sources.map(s => [s.data.slug ?? s.id.replace(/\.md$/, ''), s.data.title]));

  // Reverse index: which terms cite this source (from term.provenance).
  const citedBy = new Map<string, Array<{ slug: string; title: string }>>();
  for (const t of terms) {
    for (const p of t.data.provenance) {
      if (!citedBy.has(p)) citedBy.set(p, []);
      citedBy.get(p)!.push({ slug: t.data.slug ?? t.id.replace(/\.md$/, ''), title: t.data.title });
    }
  }

  return sources.map(entry => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: {
        entry,
        relatedTerms: citedBy.get(slug) ?? [],
        relatedSources: (entry.data.related ?? [])
          .filter(r => srcTitle.has(r))
          .map(r => ({ slug: r, title: srcTitle.get(r)! })),
      },
    };
  });
}

const { entry, relatedTerms, relatedSources } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const collLabel: Record<string, string> = {
  'SRMW': 'Self-Referential Metanovel',
  'Silicon Children': 'Silicon Children',
  '70YearsWTF': '70 Years WTF',
  'AI WTF': 'AI WTF',
};
---
<Base title={d.title} description={d.excerpt}>
  <article class="max-w-2xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <a href="/corpus/" class="text-xs font-mono text-muted hover:text-copper transition-colors">← Corpus</a>
    <div class="mt-4 mb-8">
      <p class="text-xs font-mono uppercase tracking-label text-copper mb-2">
        {collLabel[d.collection] ?? d.collection} · {d.kind}
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl font-normal text-ink leading-tight">{d.title}</h1>
      {d.subtitle && <p class="font-serif italic text-muted text-lg mt-2">{d.subtitle}</p>}
      <div class="mt-3 flex flex-wrap gap-3 text-[11px] font-mono text-faint">
        <span>{d.author}</span>
        {d.date && <span>· {d.date}</span>}
        {d.word_count > 0 && <span>· {d.word_count.toLocaleString()} words</span>}
        {d.original_url && <a href={d.original_url} target="_blank" rel="noopener" class="text-teal hover:text-copper">· original ↗</a>}
      </div>
    </div>

    <div class="prose-lib">
      <Content />
    </div>

    {(relatedTerms.length > 0 || relatedSources.length > 0) && (
      <div class="mt-14 pt-8 border-t border-rule grid sm:grid-cols-2 gap-8">
        {relatedTerms.length > 0 && (
          <div>
            <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Terms discussed here</p>
            <div class="flex flex-wrap gap-2">
              {relatedTerms.map(t => (
                <a href={`/dictionary/#term-${t.slug}`} class="text-xs bg-teal-light text-teal border border-teal-border px-2.5 py-1 rounded-full hover:border-teal transition-colors">{t.title}</a>
              ))}
            </div>
          </div>
        )}
        {relatedSources.length > 0 && (
          <div>
            <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Related reading</p>
            <ul class="space-y-1.5">
              {relatedSources.map(s => (
                <li><a href={`/corpus/${s.slug}/`} class="text-sm text-teal hover:text-copper underline underline-offset-2 decoration-teal/30">{s.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </article>
</Base>

<style is:global>
  .prose-lib { font-family: 'Literata', Georgia, serif; color: #3d2c1e; line-height: 1.9; font-size: 1.05rem; }
  .prose-lib p { margin-bottom: 1.4rem; }
  .prose-lib h1, .prose-lib h2, .prose-lib h3 { font-family: 'Literata', Georgia, serif; color: #1a1a2e; margin-top: 2.4rem; margin-bottom: 1rem; line-height: 1.3; font-weight: 500; }
  .prose-lib h2 { font-size: 1.5rem; }
  .prose-lib h3 { font-size: 1.2rem; }
  .prose-lib blockquote { border-left: 3px solid #b87333; padding: 0.4rem 1.2rem; margin: 1.6rem 0; background: rgba(184,115,51,0.05); font-style: italic; color: #3d2c1e; }
  .prose-lib a { color: #2a9d8f; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(42,157,143,0.35); }
  .prose-lib a:hover { text-decoration-color: #2a9d8f; }
  .prose-lib ul, .prose-lib ol { margin: 1.2rem 0 1.4rem 1.4rem; }
  .prose-lib li { margin-bottom: 0.5rem; }
  .prose-lib em { font-style: italic; }
  .prose-lib strong { font-weight: 600; color: #1a1a2e; }
  .prose-lib hr { border: none; border-top: 1px solid rgba(26,26,46,0.12); margin: 2.4rem 0; }
  .prose-lib img { max-width: 100%; border-radius: 6px; margin: 1.6rem 0; }
  .prose-lib code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: rgba(26,26,46,0.05); padding: 0.1em 0.35em; border-radius: 3px; }
</style>
