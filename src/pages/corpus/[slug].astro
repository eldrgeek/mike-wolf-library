---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const terms = await getCollection('terms');

  const termBySlug = new Map(terms.map(t => [t.data.slug ?? t.id.replace(/\.md$/, ''), t.data.title]));
  const srcTitle = new Map(sources.map(s => [s.data.slug ?? s.id.replace(/\.md$/, ''), s.data.title]));

  // Reverse index: which terms cite this source (from term.provenance).
  const citedBy = new Map<string, Array<{ slug: string; title: string }>>();
  for (const t of terms) {
    for (const p of t.data.provenance) {
      if (!citedBy.has(p)) citedBy.set(p, []);
      citedBy.get(p)!.push({ slug: t.data.slug ?? t.id.replace(/\.md$/, ''), title: t.data.title });
    }
  }

  // Reading order within each collection, for the previous/next links: the
  // book in printed order, everything else oldest first.
  const slugOf = (e: typeof sources[number]) => e.data.slug ?? e.id.replace(/\.md$/, '');
  const byCollection = new Map<string, typeof sources>();
  for (const s of sources) {
    if (!byCollection.has(s.data.collection)) byCollection.set(s.data.collection, []);
    byCollection.get(s.data.collection)!.push(s);
  }
  const neighbours = new Map<string, { prev?: { slug: string; title: string }; next?: { slug: string; title: string }; pos: number; total: number }>();
  for (const list of byCollection.values()) {
    list.sort((a, b) =>
      ((a.data.order ?? 0) - (b.data.order ?? 0))
      || (a.data.date ?? '').localeCompare(b.data.date ?? '')
      || a.data.title.localeCompare(b.data.title));
    list.forEach((e, i) => {
      const link = (x?: typeof e) => x && { slug: slugOf(x), title: x.data.title };
      neighbours.set(slugOf(e), { prev: link(list[i - 1]), next: link(list[i + 1]), pos: i + 1, total: list.length });
    });
  }

  return sources.map(entry => {
    const slug = entry.data.slug ?? entry.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: {
        entry,
        nav: neighbours.get(slug)!,
        relatedTerms: citedBy.get(slug) ?? [],
        relatedSources: (entry.data.related ?? [])
          .filter(r => srcTitle.has(r))
          .map(r => ({ slug: r, title: srcTitle.get(r)! })),
      },
    };
  });
}

const { entry, relatedTerms, relatedSources, nav } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const isBook = d.collection === 'SRMW';
const collLabel: Record<string, string> = {
  'SRMW': 'Self-Referential Metanovel',
  'Silicon Children': 'Silicon Children',
  '70YearsWTF': '70 Years WTF',
  'AI WTF': 'AI WTF',
};
---
<Base title={d.title} description={d.excerpt}>
  {isBook && <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap" rel="stylesheet" />}
  <article class="max-w-2xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <div class="flex items-center justify-between gap-4 text-xs font-mono">
      <a href="/corpus/" class="text-muted hover:text-copper transition-colors">← Corpus</a>
      <div class="flex items-center gap-3 text-faint">
        {nav.prev
          ? <a href={`/corpus/${nav.prev.slug}/`} rel="prev" class="text-muted hover:text-copper transition-colors" title={nav.prev.title}>‹ Prev</a>
          : <span class="opacity-40">‹ Prev</span>}
        <span>{nav.pos} / {nav.total}</span>
        {nav.next
          ? <a href={`/corpus/${nav.next.slug}/`} rel="next" class="text-muted hover:text-copper transition-colors" title={nav.next.title}>Next ›</a>
          : <span class="opacity-40">Next ›</span>}
      </div>
    </div>
    <div class="mt-4 mb-8">
      <p class="text-xs font-mono uppercase tracking-label text-copper mb-2">
        {collLabel[d.collection] ?? d.collection} · {d.kind}
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl font-normal text-ink leading-tight">{d.title}</h1>
      {d.subtitle && <p class="font-serif italic text-muted text-lg mt-2">{d.subtitle}</p>}
      <div class="mt-3 flex flex-wrap gap-3 text-[11px] font-mono text-faint">
        <span>{d.author}</span>
        {d.date && <span>· {d.date}</span>}
        {d.word_count > 0 && <span>· {d.word_count.toLocaleString()} words</span>}
        {d.original_url && <a href={d.original_url} target="_blank" rel="noopener" class="text-teal hover:text-copper">· original ↗</a>}
      </div>
    </div>

    {/*
      SOMA §17 safety boundary — the property that outranks the feature.

      This is the ARCHIVE: ~759 imported 70YearsWTF/Substack posts, the SRMW
      book, the Silicon Children manifesto. Every one of these is a PUBLISHED
      ORIGINAL. An admin editing a post body in place and canonizing it would
      silently fork the archive from what Mike actually published — and the
      fork would be invisible, because the page would still look like the
      archive. Opt-out, not opt-in: [data-user-content] is what live-edit.js
      refuses to walk into.

      Dictionary entries, headings, nav and site copy stay editable. That is
      the whole point of the feature. This is the line.
    */}
    <div class:list={['prose-lib', { 'srmw-book': isBook, 'srmw-cover-page': d.kind === 'cover' }]} data-user-content>
      <Content />
    </div>

    <p class="mt-8 text-[11px] font-mono text-faint">
      {isBook
        ? 'Typeset from the published PDF (Salt Pond Publishing, 2012). Every word is as printed; only line breaks, running heads and hyphenation were removed.'
        : 'Archived as published. This text is not edited here.'}
    </p>

    <nav class="mt-10 grid grid-cols-2 gap-3" aria-label="Previous and next">
      {nav.prev ? (
        <a href={`/corpus/${nav.prev.slug}/`} rel="prev" class="group block border border-rule rounded-md px-4 py-3 bg-surface hover:border-copper transition-colors">
          <span class="block text-[10px] font-mono uppercase tracking-label text-faint">‹ Previous</span>
          <span class="block mt-1 font-serif text-sm text-ink group-hover:text-copper leading-snug" data-user-content>{nav.prev.title}</span>
        </a>
      ) : <span></span>}
      {nav.next ? (
        <a href={`/corpus/${nav.next.slug}/`} rel="next" class="group block border border-rule rounded-md px-4 py-3 bg-surface hover:border-copper transition-colors text-right">
          <span class="block text-[10px] font-mono uppercase tracking-label text-faint">Next ›</span>
          <span class="block mt-1 font-serif text-sm text-ink group-hover:text-copper leading-snug" data-user-content>{nav.next.title}</span>
        </a>
      ) : <span></span>}
    </nav>

    {(relatedTerms.length > 0 || relatedSources.length > 0) && (
      <div class="mt-14 pt-8 border-t border-rule grid sm:grid-cols-2 gap-8">
        {relatedTerms.length > 0 && (
          <div>
            <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Terms discussed here</p>
            <div class="flex flex-wrap gap-2">
              {relatedTerms.map(t => (
                <a href={`/dictionary/#term-${t.slug}`} class="text-xs bg-teal-light text-teal border border-teal-border px-2.5 py-1 rounded-full hover:border-teal transition-colors">{t.title}</a>
              ))}
            </div>
          </div>
        )}
        {relatedSources.length > 0 && (
          <div>
            <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Related reading</p>
            <ul class="space-y-1.5">
              {relatedSources.map(s => (
                <li><a href={`/corpus/${s.slug}/`} class="text-sm text-teal hover:text-copper underline underline-offset-2 decoration-teal/30">{s.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </article>
</Base>

<script>
  // ← and → step through the collection, unless the reader is typing.
  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const rel = e.key === 'ArrowLeft' ? 'prev' : e.key === 'ArrowRight' ? 'next' : '';
    const a = rel && document.querySelector<HTMLAnchorElement>(`a[rel="${rel}"]`);
    if (a) window.location.href = a.href;
  });
</script>

<style is:global>
  /* ── SRMW: the book's own typography, rebuilt from the PDF ─────────────── */
  .prose-lib.srmw-book p:not([class]) { margin-bottom: 0; text-indent: 1.6em; }
.prose-lib.srmw-book :is(h3, .display, blockquote, .inset, .note-script, div.pg) + p:not([class]),
  .prose-lib.srmw-book > p:not([class]):first-child { text-indent: 0; }
  .srmw-book h3 { text-align: center; font-size: 1.15rem; font-weight: 600; margin: 2.6rem 0 1.1rem; letter-spacing: 0.01em; }
  .srmw-book .display { text-indent: 0; text-align: center; font-size: 1.5rem; line-height: 1.35; margin: 3rem 0; color: #1a1a2e; }
  .srmw-book .display-xl { font-size: clamp(1.4rem, 3.6vw, 1.85rem); }
  .srmw-book .display-l { font-size: 1.35rem; }
  .srmw-book .big { font-size: 1.6em; line-height: 1.2; }
  .srmw-book em.sans { font-family: 'Outfit', system-ui, sans-serif; font-style: italic; font-size: 0.95em; }
  .srmw-book blockquote.cite { font-family: 'Outfit', system-ui, sans-serif; font-style: normal; font-size: 0.92rem; line-height: 1.7; margin: 1.2rem 0 1.2rem 1.6rem; border-left-width: 2px; }
  .srmw-book blockquote.cite p { text-indent: 0; margin: 0; }
  .srmw-book .inset { text-indent: 0; margin: 1rem 0 1rem 2.4rem; }
  .srmw-book .inset.center { margin-left: 0; text-align: center; }
  .srmw-book .voice-lucida { font-family: 'Lucida Sans', 'Lucida Grande', 'Outfit', sans-serif; font-size: 0.95rem; }
  .srmw-book .note-script { text-indent: 0; font-family: 'Caveat', 'Segoe Script', cursive; font-size: 1.3rem; line-height: 1.45; color: #1a1a2e;
    background: #fff8c4; padding: 1rem 1.3rem; margin: 1.6rem auto; max-width: 27rem; transform: rotate(-1.2deg); box-shadow: 0 2px 6px rgba(26,26,46,0.12); }
  .srmw-book sup { font-size: 0.65em; line-height: 0; }
  .srmw-book sup.fnref a { text-decoration: none; padding: 0 0.1em; }
  .srmw-book .footnotes { margin-top: 2.4rem; padding-top: 1rem; border-top: 1px solid rgba(26,26,46,0.12); }
  .srmw-book .footnote { text-indent: 0; font-size: 0.85rem; line-height: 1.7; margin-bottom: 0.8rem; color: #6b6b7b; }
  .srmw-book .fnnum { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #b87333; margin-right: 0.35rem; }
  .srmw-book .fnback { text-decoration: none; margin-left: 0.2rem; }
  .srmw-book [id] { scroll-margin-top: 5rem; }
  /* Printed page numbers sit in the left margin, level with where the page began. */
  .srmw-book { position: relative; }
  @media (min-width: 900px) {
    .srmw-book .pg::before { content: 'p. ' attr(data-page); position: absolute; left: -5.2rem; width: 4rem; text-align: right; margin-top: 0.55em;
      font: 400 10px/1 'JetBrains Mono', monospace; color: #9b9bab; text-indent: 0; font-style: normal; }
  }
  .srmw-book ol.toc { list-style: none; margin: 0.5rem 0 2rem; padding: 0; font-size: 0.98rem; }
  .srmw-book ol.toc li { display: flex; align-items: baseline; gap: 0.5rem; margin: 0; line-height: 1.75; }
  .srmw-book ol.toc li .toc-title { flex: 0 1 auto; }
  .srmw-book ol.toc li::after { content: ''; flex: 1 1 2rem; order: 1; border-bottom: 1px dotted rgba(26,26,46,0.25); transform: translateY(-0.3em); }
  .srmw-book ol.toc li .toc-page { order: 2; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #9b9bab; }
  .srmw-book ol.toc li.toc-part { margin-top: 1rem; font-weight: 600; }
  .srmw-book ol.toc li.toc-item { padding-left: 1.4rem; }
  .srmw-book ol.toc a { text-decoration: none; color: inherit; }
  .srmw-book ol.toc a:hover { color: #b87333; }

  /* ── SRMW cover ─────────────────────────────────────────────────────────── */
  .srmw-cover { text-align: center; background: #1a1a2e; color: #faf8f4; border-radius: 6px; padding: 3.5rem 1.5rem 3rem; margin-bottom: 3rem; }
  .srmw-cover p { text-indent: 0; margin: 0; }
  .srmw-cover .cover-title { font-family: 'Outfit', system-ui, sans-serif; font-style: italic; font-weight: 500; font-size: clamp(1.8rem, 6vw, 2.7rem); line-height: 1.15; color: #faf8f4; }
  .srmw-cover .cover-subtitle { font-family: 'Outfit', system-ui, sans-serif; font-style: italic; font-size: clamp(1.1rem, 3.5vw, 1.5rem); color: #e4b98c; margin-top: 0.8rem; }
  .srmw-cover .cover-blurbs { font-family: 'Outfit', system-ui, sans-serif; font-style: italic; font-size: 0.95rem; line-height: 1.75; color: rgba(250,248,244,0.75); margin-top: 2.4rem; }
  .srmw-cover .cover-authors { font-family: 'Literata', Georgia, serif; font-size: 1.05rem; line-height: 1.8; margin-top: 2.6rem; color: #faf8f4; }
  .srmw-colophon, .srmw-dedication { text-align: center; }
  .srmw-colophon p, .srmw-dedication p { text-indent: 0; margin: 0 0 1.4rem; }
  .srmw-colophon { font-size: 0.9rem; color: #6b6b7b; }
  .srmw-colophon .isbn { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; }
  .srmw-dedication { font-style: italic; font-size: 1.1rem; margin-top: 2.4rem; }

  .prose-lib { font-family: 'Literata', Georgia, serif; color: #3d2c1e; line-height: 1.9; font-size: 1.05rem; }
  .prose-lib p { margin-bottom: 1.4rem; }
  .prose-lib h1, .prose-lib h2, .prose-lib h3 { font-family: 'Literata', Georgia, serif; color: #1a1a2e; margin-top: 2.4rem; margin-bottom: 1rem; line-height: 1.3; font-weight: 500; }
  .prose-lib h2 { font-size: 1.5rem; }
  .prose-lib h3 { font-size: 1.2rem; }
  .prose-lib blockquote { border-left: 3px solid #b87333; padding: 0.4rem 1.2rem; margin: 1.6rem 0; background: rgba(184,115,51,0.05); font-style: italic; color: #3d2c1e; }
  .prose-lib a { color: #2a9d8f; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(42,157,143,0.35); }
  .prose-lib a:hover { text-decoration-color: #2a9d8f; }
  .prose-lib ul, .prose-lib ol { margin: 1.2rem 0 1.4rem 1.4rem; }
  .prose-lib li { margin-bottom: 0.5rem; }
  .prose-lib em { font-style: italic; }
  .prose-lib strong { font-weight: 600; color: #1a1a2e; }
  .prose-lib hr { border: none; border-top: 1px solid rgba(26,26,46,0.12); margin: 2.4rem 0; }
  .prose-lib img { max-width: 100%; border-radius: 6px; margin: 1.6rem 0; }
  .prose-lib code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: rgba(26,26,46,0.05); padding: 0.1em 0.35em; border-radius: 3px; }
</style>
