---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const rawTerms = await getCollection('terms');
const rawSources = await getCollection('sources');

const sourceTitle = new Map<string, string>();
for (const s of rawSources) {
  sourceTitle.set(s.slug ?? s.id.replace(/\.md$/, ''), s.data.title);
}

const terms = rawTerms.map(e => {
  const slug = e.slug;
  return {
    slug,
    letter: e.data.letter,
    title: e.data.title,
    subtitle: e.data.subtitle,
    theme: e.data.theme,
    origin: e.data.origin,
    related: e.data.related,
    provenance: e.data.provenance,
    tags: e.data.tags,
    link: e.data.link,
    link_label: e.data.link_label,
    definition: e.body, // pre-rendered HTML from ingest
  };
}).sort((a, b) => a.title.localeCompare(b.title));

const titleBySlug = new Map(terms.map(t => [t.slug, t.title]));

const termsByLetter = terms.reduce((acc, t) => {
  const l = (t.letter || t.title[0]).toUpperCase();
  (acc[l] ||= []).push(t);
  return acc;
}, {} as Record<string, typeof terms>);
const letters = Object.keys(termsByLetter).sort();
const stripHtml = (h: string) => h.replace(/<[^>]*>/g, ' ');
---
<Base title="Dictionary" description={`A working dictionary of the private dialect Mike Wolf and his AI collaborators speak — ${terms.length} cross-referenced terms.`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-4">
    <p class="text-xs font-mono uppercase tracking-label text-copper mb-3">Dictionary</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">The Lexicon</h1>
    <p class="text-muted max-w-2xl leading-relaxed font-serif">
      {terms.length} terms — some coined outright, others ordinary words carrying a private
      overload. Each links to related terms and to the corpus passages where it lives.
    </p>
  </div>

  <div id="dict-nav" class="sticky top-14 z-40 bg-bg/95 backdrop-blur-sm border-b border-rule">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
      <div class="flex items-center gap-3 flex-1 min-w-0">
        <div class="relative flex-1 max-w-xs">
          <input id="dict-search" type="search" placeholder="Filter terms…"
            class="w-full px-3 py-1.5 text-sm border border-rule rounded-md bg-surface text-ink placeholder:text-faint focus:outline-none focus:border-copper/50 focus:ring-1 focus:ring-copper/20" />
        </div>
        <span id="dict-count" class="text-xs text-muted whitespace-nowrap tabular-nums font-mono">{terms.length} terms</span>
      </div>
      <div class="flex flex-wrap gap-1">
        {letters.map(l => (
          <a href={`#letter-${l}`} data-letter={l}
            class="dict-letter w-7 h-7 flex items-center justify-center rounded text-xs font-medium text-muted border border-transparent hover:bg-surface hover:border-rule hover:text-ink transition-colors">{l}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 mt-6">
    {letters.map(letter => (
      <div id={`letter-${letter}`} class="dict-section mb-14 scroll-mt-28" data-letter={letter}>
        <div class="flex items-center gap-4 mb-8">
          <span class="font-serif text-5xl font-medium text-copper/25">{letter}</span>
          <div class="h-px flex-1 bg-rule" />
        </div>
        <div class="space-y-12">
          {termsByLetter[letter].map(term => (
            <article id={`term-${term.slug}`} class="dict-entry scroll-mt-28"
              data-search={`${term.title} ${term.subtitle ?? ''} ${stripHtml(term.definition)} ${term.tags.join(' ')}`.toLowerCase()}>
              <div class="mb-3">
                <div class="flex flex-wrap items-baseline gap-2 mb-1">
                  <h2 class="font-serif text-2xl font-medium text-ink">{term.title}</h2>
                  {term.theme && <span class="text-xs font-mono uppercase tracking-label text-teal">{term.theme}</span>}
                  <button
                    class="term-share ml-auto shrink-0 self-center inline-flex items-center gap-1 text-muted hover:text-copper transition-colors p-1 rounded"
                    data-slug={term.slug}
                    data-title={term.title}
                    aria-label={`Copy link to ${term.title}`}
                    title="Copy link to this entry">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span class="term-share-toast hidden text-xs text-copper">Copied</span>
                  </button>
                </div>
                {term.subtitle && <p class="font-serif italic text-muted text-base">{term.subtitle}</p>}
              </div>

              <div class="bg-surface border border-rule rounded-lg p-6 mb-4 dict-body">
                <div set:html={term.definition} />
              </div>

              {term.origin && (
                <p class="text-xs text-muted mb-3"><span class="font-medium uppercase tracking-wide text-copper">Origin.</span> {term.origin}</p>
              )}

              <div class="flex flex-wrap items-center gap-2">
                {term.tags.map(tag => (
                  <span class="text-xs bg-copper-light text-copper px-2.5 py-1 rounded-full border border-copper-border">{tag}</span>
                ))}
                {term.related.length > 0 && <span class="text-xs text-muted self-center ml-1">→ see also:</span>}
                {term.related.slice(0, 8).map(slug => (
                  titleBySlug.has(slug) ? (
                    <a href={`#term-${slug}`} class="text-xs text-teal hover:text-copper underline underline-offset-2 decoration-teal/30">{titleBySlug.get(slug)}</a>
                  ) : null
                ))}
              </div>

              {term.link && (
                <p class="mt-3 text-xs">
                  <span class="font-medium uppercase tracking-wide text-copper">Visit:</span>{' '}
                  <a href={term.link} target="_blank" rel="noopener" class="text-teal hover:text-copper underline underline-offset-2 decoration-teal/30">
                    {term.link_label || term.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                  </a>
                </p>
              )}

              {term.provenance.filter(p => sourceTitle.has(p)).length > 0 && (
                <p class="mt-3 text-xs text-muted">
                  <span class="font-medium uppercase tracking-wide text-copper">Discussed in:</span>{' '}
                  {term.provenance.filter(p => sourceTitle.has(p)).slice(0, 6).map((p, i, arr) => (
                    <>
                      <a href={`/corpus/${p}/`} class="text-teal hover:text-copper underline underline-offset-2 decoration-teal/30">{sourceTitle.get(p)}</a>{i < arr.length - 1 ? '; ' : ''}
                    </>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div id="dict-empty" class="hidden max-w-5xl mx-auto px-4 sm:px-6 py-16 text-center">
    <p class="text-muted">No terms match your search.</p>
  </div>
</Base>

<style is:global>
  .dict-body p { margin-bottom: 0.9rem; line-height: 1.75; color: #3d2c1e; font-family: 'Literata', Georgia, serif; }
  .dict-body p:last-child { margin-bottom: 0; }
  .dict-body a { color: #2a9d8f; text-decoration: underline; text-underline-offset: 2px; }
</style>

<script>
  // Copy / share a deep link to a single entry.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.term-share') as HTMLElement | null;
    if (!btn) return;
    const slug = btn.getAttribute('data-slug');
    const title = btn.getAttribute('data-title') || 'Dictionary entry';
    const path = location.pathname.endsWith('/') ? location.pathname : location.pathname + '/';
    const url = `${location.origin}${path}#term-${slug}`;
    try {
      if ((navigator as any).share && window.matchMedia('(max-width: 640px)').matches) {
        await (navigator as any).share({ title: `“${title}” — The Library`, url });
      } else {
        await navigator.clipboard.writeText(url);
        const toast = btn.querySelector('.term-share-toast') as HTMLElement | null;
        if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 1400); }
      }
    } catch (_) { /* user cancelled share or clipboard unavailable */ }
  });

  const input = document.getElementById('dict-search') as HTMLInputElement;
  const countEl = document.getElementById('dict-count') as HTMLElement;
  const emptyEl = document.getElementById('dict-empty') as HTMLElement;
  const entries = document.querySelectorAll<HTMLElement>('.dict-entry');
  const sections = document.querySelectorAll<HTMLElement>('.dict-section');
  const total = entries.length;

  function apply(raw: string) {
    const q = raw.trim().toLowerCase();
    let shown = 0;
    entries.forEach(el => {
      const match = !q || (el.dataset.search ?? '').includes(q);
      el.hidden = !match;
      if (match) shown++;
    });
    sections.forEach(sec => {
      const has = [...sec.querySelectorAll<HTMLElement>('.dict-entry')].some(e => !e.hidden);
      sec.hidden = !has;
    });
    countEl.textContent = q ? `${shown} of ${total}` : `${total} terms`;
    emptyEl.classList.toggle('hidden', shown > 0);
  }
  input?.addEventListener('input', () => apply(input.value));
</script>
